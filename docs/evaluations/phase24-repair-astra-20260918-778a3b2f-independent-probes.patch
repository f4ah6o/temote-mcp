+#[cfg(test)]
+mod phase24_astra_independent_tests {
+    use super::*;
+    #[test]
+    fn phase24_astra_missing_top_level_metadata_is_not_silently_omitted() {
+        let fixture = tempfile::tempdir().unwrap();
+        let cwd = std::fs::canonicalize(fixture.path()).unwrap();
+        let policy = LinuxSandboxPolicy::for_command(&cwd, &[cwd.clone()], &[]).unwrap();
+        let args = build_bwrap_args(&policy, vec!["/bin/true".to_owned()], 999, None).unwrap();
+        for name in [".git", ".agents", ".codex"] {
+            let path = cwd.join(name).display().to_string();
+            assert!(args.contains(&path), "writable workspace protection omitted missing {name}: {args:?}");
+        }
+    }
