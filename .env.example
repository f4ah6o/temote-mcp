# Public origin used by ChatGPT and Cloudflare Access.
TEMOTE_MCP_PUBLIC_URL=https://temotemcp.example.com

# Cloudflare Access team domain, with or without the https:// prefix.
TEMOTE_MCP_ACCESS_TEAM_DOMAIN=https://replace-with-your-team.cloudflareaccess.com

# Audience (AUD) of the self-hosted Cloudflare Access application that protects
# temotemcp.example.com. Do not use the AUD of an AI Controls MCP portal entry.
TEMOTE_MCP_ACCESS_AUDIENCE=replace-with-cloudflare-access-audience

# Comma-separated, case-insensitive allow list.
TEMOTE_MCP_ACCESS_ALLOWED_EMAILS=replace-with-your-email@example.com

# Remotely managed Cloudflare Tunnel run token.
TEMOTE_MCP_TUNNEL_TOKEN=replace-with-tunnel-run-token

# Optional serverless multi-host gateway agent. These values belong on each
# endpoint; keep real tokens outside the repository.
TEMOTE_MCP_GATEWAY_URL=https://gateway.example.com
TEMOTE_MCP_GATEWAY_HOST_TOKEN=replace-with-worker-host-token
TEMOTE_MCP_GATEWAY_ACCESS_CLIENT_ID=replace-with-access-service-token-id
TEMOTE_MCP_GATEWAY_ACCESS_CLIENT_SECRET=replace-with-access-service-token-secret
